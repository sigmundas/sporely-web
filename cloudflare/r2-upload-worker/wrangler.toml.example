name = "sporely-r2-upload"
main = "src/index.js"
compatibility_date = "2026-04-10"

[[r2_buckets]]
binding = "MEDIA_BUCKET"
bucket_name = "sporely-media"

[vars]
MEDIA_STORAGE_MODE = "legacy"
SUPABASE_URL = "https://zkpjklzfwzefhjluvhfw.supabase.co"
SUPABASE_JWT_AUDIENCE = "authenticated"
MEDIA_PUBLIC_BASE_URL = "https://media.sporely.no"
ALLOWED_ORIGINS = "https://app.sporely.no,https://sporely.no,https://www.sporely.no,http://localhost:5173,https://localhost,capacitor://localhost"
MAX_UPLOAD_BYTES = "15728640"
# Free-plan account quota (2 GiB). A non-null profiles.storage_quota_bytes
# overrides it; Pro accounts have no quota. 0 means unlimited.
FREE_STORAGE_QUOTA_BYTES = "2147483648"

# Optional overrides:
# SUPABASE_JWT_ISSUER = "https://zkpjklzfwzefhjluvhfw.supabase.co/auth/v1"
# SUPABASE_JWKS_URL = "https://zkpjklzfwzefhjluvhfw.supabase.co/auth/v1/.well-known/jwks.json"
# JWT_CLOCK_SKEW_SECONDS = "60"

# Only needed if your Supabase project still signs access tokens with HS* keys.
# Set this with `wrangler secret put SUPABASE_JWT_SECRET`, not in plaintext.

# Needed for storage quota/tally updates.
# Set this with `wrangler secret put SUPABASE_SERVICE_ROLE_KEY`, not in plaintext.
